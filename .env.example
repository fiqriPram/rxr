# Database Neon (PostgreSQL) connection string
# Dapatkan dari dashboard Neon (https://console.neon.tech)
DATABASE_URL="postgresql://username:password@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application Settings
NEXT_PUBLIC_APP_NAME="RXR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# VIPayment API (top-up game real) — https://vip-reseller.co.id/account/profile
# Jika dikosongkan, aplikasi otomatis memakai mode demo (nickname & pengiriman disimulasikan).
VIPAYMENT_API_ID=""
VIPAYMENT_API_KEY=""
# Optional: override base URL
# VIPAYMENT_API_URL="https://vip-reseller.co.id/api/game-feature"

# Admin dashboard (/admin) & /api/admin/* — wajib diisi, jangan dibagikan.
# Login via halaman /admin/login. Ganti dengan password kuat yang unik.
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# Secret untuk session login user (wajib unik per environment).
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# Duitku payment gateway — https://passport.duitku.com
# DUITKU_ENV: "sandbox" untuk tes, "production" untuk live.
DUITKU_ENV="sandbox"
DUITKU_MERCHANT_CODE=""
DUITKU_API_KEY=""
